    m_Metadata:
      m_Items: []
  - m_Id: 176296697692165
    m_Localized: Gate Guard
    m_Metadata:
      m_Items: []
  - m_Id: 176296697692166
    m_Localized: "Gold {0} \xB7 Rations {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 176296697692167
    m_Localized: Get a room first
    m_Metadata:
      m_Items: []
  - m_Id: 176296697692168
    m_Localized: Welcome. Let me know if you need a room. I sell rations for expeditions
      too.
    m_Metadata:
      m_Items: []
  - m_Id: 176296697692169
    m_Localized: Your room is through the inner door. Mercenaries and work are at
      the guild, at the far left of the square.
    m_Metadata:
      m_Items: []
  - m_Id: 176296697692170
    m_Localized: Here are your rations. You now have {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 176296697692171
    m_Localized: You don't have enough gold.
    m_Metadata:
      m_Items: []
  - m_Id: 176296697692172
    m_Localized: Welcome to the guild. Tell me if you need mercenaries. Quests are
      posted on that board.
    m_Metadata:
      m_Items: []
  - m_Id: 176296697692173
    m_Localized: Did you pack food? Buy at least {0} rations from the innkeeper.
    m_Metadata:
      m_Items: []
  - m_Id: 176296697692174
    m_Localized: Heading out? Be careful.
    m_Metadata:
      m_Items: []
  - m_Id: 176296697692175
    m_Localized: Glad you made it back.
    m_Metadata:
      m_Items: []
  - m_Id: 176296697692176
    m_Localized: Get a room ({0} gold)
    m_Metadata:
      m_Items: []
  - m_Id: 176296697692177
    m_Localized: Buy a day of rations ({0} gold)
    m_Metadata:
      m_Items: []
