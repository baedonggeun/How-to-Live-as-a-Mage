  - m_Id: 49082433536
    m_Localized: "WASD \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 49090822144
    m_Localized: "\uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 49090822145
    m_Localized: "W\xB7A\xB7S\xB7D\uB85C \uAC77\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 49090822146
    m_Localized: "\uB9C8\uC6B0\uC2A4\uB85C \uB458\uB7EC\uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 49090822147
    m_Localized: "\uC2DC\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 49090822148
    m_Localized: "\uB9C8\uC6B0\uC2A4\uB97C \uC6C0\uC9C1\uC5EC \uB458\uB7EC\uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 49090822149
    m_Localized: "Shift \uB2EC\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 49090822150
    m_Localized: "\uB2EC\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 49090822151
    m_Localized: "\uAC77\uB294 \uC911\uC5D0 Shift\uB97C \uB204\uB974\uACE0 \uC788\uC73C\uBA74
      \uB2EC\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 49090822152
    m_Localized: "\uC0C1\uD638\uC791\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 49090822153
    m_Localized: "\uAC00\uAE4C\uC774\uC5D0\uC11C \uD654\uBA74 \uAC00\uC6B4\uB370\uB97C
      \uB300\uBA74 \uD0A4\uC640 \uC774\uB984\uC774 \uBCF4\uC778\uB2E4. F\uB97C \uB20C\uB7EC
      \uC4F4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 655830337355776
    m_Localized: "\uC8FC\uBB38 \uADF8\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 655830354132992
    m_Localized: "\uCF54\uB371\uC2A4\uC758 \uC8FC\uBB38 \uC5F0\uC2B5 \uD0ED\uC5D0\uC11C
      \uC88C\uD074\uB9AD\uC73C\uB85C \uADF8\uB9B0\uB2E4. \uBC84\uD2BC\uC744 \uB5BC\uB3C4
      3\uCD08 \uC548\uC5D0 \uC774\uC5B4 \uADF8\uB9B4 \uC218 \uC788\uACE0, 3\uCD08
      \uB3D9\uC548 \uC548 \uADF8\uB9AC\uBA74 \uD310\uC815\uD55C\uB2E4. Space\uB294
      \uBC14\uB85C \uD310\uC815, \uC6B0\uD074\uB9AD\xB7Esc\uB294 \uCDE8\uC18C."
    m_Metadata:
      m_Items: []
  - m_Id: 1103303975534592
    m_Localized: "\uC88C\uD074\uB9AD\uC73C\uB85C \uC8FC\uBB38 \uADF8\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1103304004894720
    m_Localized: "\uD604\uC7A5\uC5D0\uC11C \uC8FC\uBB38 \uC4F0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1103304004894721
    m_Localized: "\uC88C\uD074\uB9AD\uD558\uBA74 \uD654\uBA74 \uAC00\uC6B4\uB370\uC5D0
      \uADF8\uB9B0\uB2E4. \uB9C8\uC6B0\uC2A4\uB97C \uC6C0\uC9C1\uC774\uBA74 \uD39C\uC774
      \uB530\uB77C\uC624\uACE0, \uBC84\uD2BC\uC744 \uB5BC\uB3C4 3\uCD08 \uC548\uC5D0
      \uC774\uC5B4 \uADF8\uB9B4 \uC218 \uC788\uB2E4. Space\uB97C \uB204\uB974\uBA74
      \uBC14\uB85C \uD310\uC815\uD55C\uB2E4. \uB9DE\uC73C\uBA74 3\uCD08 \uB3D9\uC548
      \uACA8\uB234\uB2E4\uAC00 \uC88C\uD074\uB9AD\uC73C\uB85C \uC3DC\uB2E4 (3\uCD08\uAC00
      \uC9C0\uB098\uBA74 \uC800\uC808\uB85C \uB098\uAC10). \uC6B0\uD074\uB9AD\uC740
      \uCDE8\uC18C. \uBD88\xB7\uBB3C \uB8EC\uC740 \uD63C\uC790 \uADF8\uB824\uB3C4
      \uB358\uC9C8 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1103304004894722
    m_Localized: "M\uC73C\uB85C \uC9C0\uB3C4 \uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1103304004894723
    m_Localized: "\uC9C0\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1103304004894724
    m_Localized: "\uC232\uC740 \uAC78\uC73C\uBA70 \uBC1D\uD78C\uB2E4. \uBC1D\uD78C
      \uACF3\uC740 \uB0A8\uB294\uB2E4. \uC624\uB978\uCABD \uC704 \uBBF8\uB2C8\uB9F5\uC5D0
      \uAC00\uAE4C\uC6B4 \uACF3\uC774, M\uC744 \uB204\uB974\uBA74 \uC232 \uC804\uCCB4\uAC00
      \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
