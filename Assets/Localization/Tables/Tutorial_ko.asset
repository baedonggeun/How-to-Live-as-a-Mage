  m_TableData:
  - m_Id: 49082433536
    m_Localized: "WASD \uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 49090822144
    m_Localized: "\uC774\uB3D9"
    m_Metadata:
      m_Items: []
  - m_Id: 49090822145
    m_Localized: "W\xB7A\xB7S\xB7D\uB85C \uAC77\uB294\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 49090822146
    m_Localized: "\uB9C8\uC6B0\uC2A4\uB85C \uB458\uB7EC\uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 49090822147
    m_Localized: "\uC2DC\uC810"
    m_Metadata:
      m_Items: []
  - m_Id: 49090822148
    m_Localized: "\uB9C8\uC6B0\uC2A4\uB97C \uC6C0\uC9C1\uC5EC \uB458\uB7EC\uBCF8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 49090822149
    m_Localized: "Shift \uB2EC\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 49090822150
    m_Localized: "\uB2EC\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 49090822151
    m_Localized: "\uAC77\uB294 \uC911\uC5D0 Shift\uB97C \uB204\uB974\uACE0 \uC788\uC73C\uBA74
      \uB2EC\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 49090822152
    m_Localized: "\uC0C1\uD638\uC791\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 49090822153
    m_Localized: "\uAC00\uAE4C\uC774\uC5D0\uC11C \uD654\uBA74 \uAC00\uC6B4\uB370\uB97C
      \uB300\uBA74 \uD0A4\uC640 \uC774\uB984\uC774 \uBCF4\uC778\uB2E4. F\uB97C \uB20C\uB7EC
      \uC4F4\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 655830337355776
    m_Localized: "\uC8FC\uBB38 \uADF8\uB9AC\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 655830354132992
    m_Localized: "\uCF54\uB371\uC2A4\uC758 \uC8FC\uBB38 \uC5F0\uC2B5 \uD0ED\uC5D0\uC11C
      F\uB97C \uAFB9 \uB20C\uB7EC \uC2DC\uC791\uD55C\uB2E4. \uB204\uB978 \uCC44 \uC88C\uD074\uB9AD\uC73C\uB85C
      \uC120\uC744 \uAE0B\uACE0, F\uB97C \uB5BC\uBA74 \uD310\uC815\uD55C\uB2E4. Space\uB294
      \uBC14\uB85C \uD310\uC815, \uC6B0\uD074\uB9AD\xB7Esc\uB294 \uCDE8\uC18C (\uC6B0\uD074\uB9AD\uC740
      \uAC08\uBB34\uB9AC \uC2DC\uAC04\uC774 \uAC78\uB9B0\uB2E4)."
    m_Metadata:
      m_Items: []
  - m_Id: 1103304004894722
    m_Localized: "M\uC73C\uB85C \uC9C0\uB3C4 \uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 1103304004894723
    m_Localized: "\uC9C0\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 1103304004894724
    m_Localized: "\uC232\uC740 \uAC78\uC73C\uBA70 \uBC1D\uD78C\uB2E4. \uBC1D\uD78C
      \uACF3\uC740 \uB0A8\uB294\uB2E4. \uC624\uB978\uCABD \uC704 \uBBF8\uB2C8\uB9F5\uC5D0
      \uAC00\uAE4C\uC6B4 \uACF3\uC774, M\uC744 \uB204\uB974\uBA74 \uC232 \uC804\uCCB4\uAC00
      \uBCF4\uC778\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1321611895144448
    m_Localized: "\uC804\uD22C"
    m_Metadata:
      m_Items: []
  - m_Id: 1321611907727360
    m_Localized: "F\uB97C \uAFB9 \uB20C\uB7EC \uADF8\uB9AC\uAE30 \u2192 F\uB97C \uB5BC\uC11C
      \uD310\uC815 \u2192 3\uCD08 \uC870\uC900 \u2192 \uBC1C\uC0AC. \uADF8\uB9BC\uC774
      \uB9DE\uC9C0 \uC54A\uC73C\uBA74 \uC2E4\uD328\uD574\uC11C \uCCB4\uB825\xB7\uB9C8\uB098\xB7\uC2A4\uD0DC\uBBF8\uB098\uB97C
      \uC783\uB294\uB2E4. \uC6B0\uD074\uB9AD \uCDE8\uC18C\uB294 \uB8EC \uC218\uB9CC\uD07C
      \uAC08\uBB34\uB9AC\uD55C\uB2E4. \uBD88\xB7\uBB3C \uB8EC\uC740 \uD63C\uC790\uC11C\uB3C4
      \uB358\uC9C8 \uC218 \uC788\uB2E4. \uB3D9\uB8CC\uB294 \uC54C\uC544\uC11C \uC2F8\uC6B0\uACE0,
      \uC4F0\uB7EC\uC9C0\uBA74 \uC8FD\uB294\uB2E4. \uB9C8\uBC95\uC0AC\uAC00 \uC4F0\uB7EC\uC9C0\uBA74
      \uAE08\uD654\uB97C \uB5A8\uC5B4\uB728\uB9AC\uACE0 \uC5EC\uAD00\uC5D0\uC11C
      \uAE68\uC5B4\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1321611907727361
    m_Localized: "\uC801\uC774 \uB2E4\uAC00\uC628\uB2E4. F\uB97C \uAFB9 \uB204\uB974\uBA74
      \uC2DC\uC804 \uC0C1\uD0DC\uAC00 \uB418\uACE0, \uD654\uBA74 \uAC00\uC6B4\uB370\uC5D0
      \uC591\uD53C\uC9C0\uAC00 \uB098\uD0C0\uB09C\uB2E4. \uB204\uB974\uACE0 \uC788\uB294
      \uB3D9\uC548 \uC88C\uD074\uB9AD\uC744 \uB204\uB978 \uCC44 \uB9C8\uC6B0\uC2A4\uB97C
      \uC6C0\uC9C1\uC5EC \uC591\uD53C\uC9C0 \uC704\uC5D0 \uC8FC\uBB38\uC744 \uADF8\uB9B0\uB2E4.
      \uC120\uC740 \uC5EC\uB7EC \uBC88 \uB098\uB220 \uADF8\uC744 \uC218 \uC788\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1321611907727362
    m_Localized: "F\uB97C \uB5BC\uBA74 \uD310\uC815\uD55C\uB2E4. \uCF54\uB371\uC2A4\uC5D0
      \uC788\uB294 \uADF8\uB9BC\uACFC \uB9DE\uC544\uC57C \uB098\uAC04\uB2E4. \uB9DE\uC9C0
      \uC54A\uC73C\uBA74 \uB9C8\uBC95\uC774 \uC2E4\uD328\uD574\uC11C \uCCB4\uB825\xB7\uB9C8\uB098\xB7\uC2A4\uD0DC\uBBF8\uB098\uB97C
      \uC783\uB294\uB2E4. F\uB97C 0.35\uCD08\uBCF4\uB2E4 \uC9E7\uAC8C \uB20C\uB800\uB2E4
      \uB5BC\uBA74 \uC2DC\uC804\uC774 \uC544\uB2C8\uB77C \uC0C1\uD638\uC791\uC6A9\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1321611907727363
    m_Localized: "\uADF8\uB9AC\uB294 \uB3C4\uC911 \uC6B0\uD074\uB9AD\uD558\uBA74
      \uCDE8\uC18C\uD55C\uB2E4. \uADF8\uB9B0 \uADF8\uB9BC\uC774 \uB9C8\uBC95\uC774\uBA74
      \uAC08\uBB34\uB9AC\uD558\uB290\uB77C \uB8EC \uC218\uB9CC\uD07C \uCD08 \uB3D9\uC548
      \uC544\uBB34\uAC83\uB3C4 \uBABB \uD55C\uB2E4. \uB8EC \uC8FC\uBB38\uC740 1\uCD08,
      2\uB8EC \uB9C8\uBC95\uC740 2\uCD08\uB2E4. \uB9C8\uBC95\uC774 \uC544\uB2CC \uADF8\uB9BC\uC740
      \uBC14\uB85C \uCDE8\uC18C\uB41C\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1321611907727364
    m_Localized: "\uB9DE\uC73C\uBA74 3\uCD08 \uB3D9\uC548 \uB9C8\uC6B0\uC2A4\uB85C
      \uACA8\uB208\uB2E4. \uC88C\uD074\uB9AD\uD558\uBA74 \uC3D8\uACE0, 3\uCD08\uAC00
      \uC9C0\uB098\uBA74 \uC800\uC808\uB85C \uB098\uAC04\uB2E4. \uACA8\uB204\uB294
      \uB3D9\uC548\uC5D0\uB294 \uC6C0\uC9C1\uC77C \uC218 \uC5C6\uB2E4. \uACA8\uB204\uB294
      \uC911\uC5D0 \uC6B0\uD074\uB9AD\uD574\uB3C4 \uAC19\uC740 \uAC08\uBB34\uB9AC\uAC00
      \uAC78\uB9B0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1321611907727365
    m_Localized: "\uBD88\xB7\uBB3C\uCC98\uB7FC \uBB34\uC5B8\uAC00\uB97C \uB9CC\uB4DC\uB294
      \uB8EC\uC740 \uD63C\uC790 \uADF8\uB824\uB3C4 \uB358\uC9C8 \uC218 \uC788\uB2E4.
      \uC751\uCD95\xB7\uC9C1\uC120\xB7\uCC28\uB2E8\uC740 \uD63C\uC790\uC11C\uB294
      \uD6A8\uACFC\uAC00 \uC5C6\uB2E4. \uB8EC\uC744 \uD569\uCE5C \uB2E4\uC911 \uB8EC
      \uB9C8\uBC95\uC774 \uB354 \uAC15\uD558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 1321611907727366
    m_Localized: "\uB3D9\uB8CC\uB294 \uC54C\uC544\uC11C \uB530\uB77C\uC624\uBA70
      \uC2F8\uC6B4\uB2E4. \uC4F0\uB7EC\uC9C4 \uB3D9\uB8CC\uB294 \uC8FD\uB294\uB2E4.
      \uB9C8\uBC95\uC0AC\uAC00 \uC4F0\uB7EC\uC9C0\uBA74 \uAC00\uC9C4 \uAE08\uD654\uB97C
      \uADF8 \uC790\uB9AC\uC5D0 \uB5A8\uC5B4\uB728\uB9AC\uACE0 \uC5EC\uAD00\uC5D0\uC11C
      \uAE68\uC5B4\uB09C\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
